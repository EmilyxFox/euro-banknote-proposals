---
import "@/src/styles/global.css";
import DefaultLayout from "@/src/layouts/default.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allDesigns = await getCollection("designs");
const sortedDesigns = allDesigns.sort((a, b) => a.id.localeCompare(b.id));

const firstDesign = sortedDesigns[0];
const defaultStartUrl = firstDesign
    ? `/design/${firstDesign.id}/${firstDesign.data.notes[0].denomination}`
    : "#";
---

<DefaultLayout>
    <main class="max-w-6xl mx-auto px-6 py-12">
        <!-- Hero Section -->
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h1
                class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 mb-4"
            >
                European Banknote Design Proposals
            </h1>
            <p class="text-lg text-gray-600 mb-8">
                Explore alternative design series and official submissions for
                Euro banknotes. Compare themes, designers, and flip through each
                denomination.
            </p>
            <a
                href={defaultStartUrl}
                class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-xl shadow-md hover:bg-blue-700 transition-all transform hover:scale-105"
            >
                Start Exploring
            </a>
        </div>

        <!-- Designs grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                sortedDesigns.map((design) => {
                    const previewNote = design.data.notes[0];
                    return (
                        <a
                            href={`/design/${design.id}/${previewNote?.denomination || 5}`}
                            class="group bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-blue-300 transition-all duration-300 flex flex-col justify-between"
                        >
                            <div>
                                <div class="flex justify-between items-center mb-4">
                                    <span class="text-xs font-bold uppercase tracking-wider bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
                                        Design {design.id.toUpperCase()}
                                    </span>
                                    <span class="text-xs text-gray-500 font-medium">
                                        {design.data.notes.length} Denominations
                                    </span>
                                </div>
                                <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-1">
                                    {design.data.theme}
                                </h2>
                                <p class="text-sm text-gray-500 mb-6 line-clamp-1">
                                    Designed by {design.data.designer}
                                </p>
                            </div>

                            {/* Preview Thumbnail Box */}
                            {previewNote && (
                                <div class="bg-gray-50 rounded-xl p-4 flex justify-center items-center h-48 overflow-hidden border border-gray-100">
                                    <Image
                                        src={previewNote.frontImage}
                                        alt={`Design ${design.id} Preview`}
                                        width={200}
                                        class="max-h-full max-w-full w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                                    />
                                </div>
                            )}
                        </a>
                    );
                })
            }
        </div>
    </main>
</DefaultLayout>
