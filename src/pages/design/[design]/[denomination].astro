---
import "@/src/styles/global.css";
import DefaultLayout from "@/src/layouts/default.astro";
import FlipCard from "@/src/components/BanknoteFlip.svelte";

import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

const baseURL = import.meta.env.BASE_URL;

export async function getStaticPaths() {
    const allDesigns = await getCollection("designs");

    return allDesigns.flatMap((design) => {
        return design.data.notes.map((note) => {
            return {
                params: {
                    design: design.id,
                    denomination: note.denomination.toString(),
                },
                props: {
                    design: design,
                    activeNote: note,
                    siblingNotes: design.data.notes,
                    allDesigns: allDesigns,
                },
            };
        });
    });
}

const {
    design: design,
    activeNote,
    siblingNotes,
    allDesigns: allDesigns,
} = Astro.props;
const { data } = design;

const { Content } = await render(design);

const sortedDesigns = allDesigns.sort((a, b) => a.id.localeCompare(b.id));
---

<DefaultLayout>
    <main class="max-w-4xl mx-auto p-6">
        <!-- Design nav -->
        <nav class="mb-8 pb-4 border-b border-gray-200">
            <p
                class="text-xs uppercase tracking-wider text-gray-500 text-center mb-3 font-semibold"
            >
                Select Design Proposal
            </p>
            <div class="flex justify-center items-center gap-2 flex-wrap">
                {
                    sortedDesigns.map((p) => {
                        const isCurrentDesign = p.id === design.id;
                        return (
                            <a
                                href={`${baseURL}/design/${p.id}/${activeNote.denomination}`}
                                class={`w-10 h-10 flex items-center justify-center rounded-lg font-bold uppercase transition-all duration-200 ${
                                    isCurrentDesign
                                        ? "bg-blue-600 text-white shadow-md scale-105"
                                        : "bg-gray-100 text-gray-700 hover:bg-gray-200"
                                }`}
                                title={`Design ${p.id.toUpperCase()} — ${p.data.theme}`}
                            >
                                {p.id}
                            </a>
                        );
                    })
                }
            </div>
        </nav>
        <div class="mb-8 text-center">
            <h1>
                <span class="text-3xl font-bold"
                    >Design {design.id.toUpperCase()}</span
                >
                <p class="text-gray-600">
                    by <span class="text-gray-800 font-bold"
                        >{data.designer}</span
                    >
                </p>
            </h1>
            <h2 class="text-3xl font-bold">€{activeNote.denomination}</h2>
        </div>

        <!-- Banknote nav -->
        <nav class="flex justify-center items-center gap-3 sm:gap-6 flex-wrap">
            {
                siblingNotes.map((n) => {
                    const isActive = n.denomination === activeNote.denomination;
                    return (
                        <a
                            href={`${baseURL}/design/${design.id}/${n.denomination}`}
                            class={`transition-all duration-200 block overflow-hidden border-2 ${
                                isActive
                                    ? "border-blue-600 scale-105 shadow-lg ring-2 ring-blue-600/20"
                                    : "border-transparent opacity-60 hover:opacity-100 hover:scale-102"
                            }`}
                            title={`€${n.denomination}`}
                        >
                            <Image
                                src={n.frontImage}
                                alt={`€${n.denomination} Thumbnail`}
                                width={120}
                                class="w-24 sm:w-28 h-auto object-contain block"
                            />
                        </a>
                    );
                })
            }
        </nav>

        <!-- Flipping banknote -->
        <div class="max-w-2xl mx-auto my-8">
            <FlipCard axis={data.flipAxis} client:load>
                <Image
                    slot="front"
                    src={activeNote.frontImage}
                    alt={`€${activeNote.denomination} Front`}
                />
                <Image
                    slot="back"
                    src={activeNote.backImage}
                    alt={`€${activeNote.denomination} Back`}
                />
            </FlipCard>
            <p class="text-center text-sm text-gray-500">
                Click the banknote to flip it over.
            </p>
        </div>

        <!-- Design prose -->
        <article class="prose mx-auto">
            <Content />
        </article>
    </main>
</DefaultLayout>
